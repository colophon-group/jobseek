{
  "name": "@jobseek/web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "pnpm proxy-matchers:update && next dev",
    "build": "pnpm blog-mentions:check && pnpm proxy-matchers:update && lingui compile && next build",
    "start": "next start",
    "lint": "eslint .",
    "traffic:analyze": "tsx script/analyze-vercel-logs.ts",
    "traffic:api": "tsx script/report-api-traffic.ts",
    "extract": "lingui extract",
    "compile": "lingui compile",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:validate-routine": "tsx scripts/validate-routine-migration.ts",
    "db:migrate:verify-head": "tsx scripts/verify-production-migration-head.ts",
    "db:migrate:apply-account-issuer": "tsx scripts/apply-better-auth-account-issuer.ts",
    "db:migrate:verify-account-issuer": "tsx scripts/verify-better-auth-account-issuer.ts",
    "db:migrate:verify-account-issuer-relaxation": "tsx scripts/verify-better-auth-account-issuer-relaxation.ts",
    "db:migrate:verify-retirement": "tsx scripts/verify-job-posting-retirement.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "analyze": "pnpm proxy-matchers:update && ANALYZE=true next build",
    "check:bundle": "tsx script/check-bundle-budget.ts",
    "cpu:gate": "tsx script/check-fluid-cpu-budget.ts",
    "optimize:svg": "svgo public/*.svg --multipass",
    "og:prewarm": "tsx script/prewarm-company-og-cache.ts",
    "og:prune": "tsx script/prune-company-og-cache.ts",
    "screenshots": "tsx script/capture-screenshots.ts",
    "smoke": "tsx script/smoke-built-app.ts",
    "notify-blog-indexnow": "tsx script/notify-blog-indexnow.ts",
    "blog-mentions:check": "tsx script/check-blog-mention-snapshot.ts",
    "blog-mentions:update": "tsx script/check-blog-mention-snapshot.ts --write",
    "proxy-matchers:check": "tsx script/generate-company-proxy-matchers.ts",
    "proxy-matchers:update": "tsx script/generate-company-proxy-matchers.ts --write",
    "test": "pnpm proxy-matchers:update && vitest run",
    "test:coverage": "pnpm proxy-matchers:update && vitest run --config vitest.coverage.config.ts",
    "test:watch": "pnpm proxy-matchers:update && vitest",
    "test:isr": "vitest run --config vitest.isr.config.ts",
    "test:jev-live": "tsx scripts/test-jev-ai-filter-live.ts",
    "typecheck": "next typegen && tsc"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@jseek/mcp-server": "workspace:*",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@nivo/sankey": "^0.99.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.6",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "entities": "^8.1.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "lucide-react": "^1.48.0",
    "negotiator": "^1.1.0",
    "next": "^16.3.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "parse5": "^8.0.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.0",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "22.6.2",
    "tailwindcss": "^4.3.3",
    "typesense": "^3.0.6",
    "workflow": "^4.8.9"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/loader": "^6.6.0",
    "@next/bundle-analyzer": "^16.3.6",
    "@next/eslint-plugin-next": "^16.3.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.0.0",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "svgo": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0"
  }
}
