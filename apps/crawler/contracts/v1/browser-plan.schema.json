{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseek.dev/contracts/crawler/v1/browser-plan.schema.json",
  "title": "Crawler browser execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "url", "required_capabilities", "navigation",
    "session", "actions", "captures", "evaluations"
  ],
  "properties": {
    "contract_version": {"const": "crawler.runtime/v1"},
    "url": {"type": "string", "format": "uri"},
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "render", "evaluate", "actions", "pagination", "response_capture",
          "request_interception", "frames", "persistent_session", "headful_identity",
          "proxy", "transport_overrides"
        ]
      }
    },
    "navigation": {"type": "object"},
    "session": {"type": "object"},
    "actions": {"type": "array", "items": {"type": "object"}},
    "captures": {"type": "array", "items": {"type": "object"}},
    "evaluations": {"type": "array", "items": {"type": "object"}}
  }
}
