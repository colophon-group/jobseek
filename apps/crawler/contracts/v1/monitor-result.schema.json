{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseek.dev/contracts/crawler/v1/monitor-result.schema.json",
  "title": "Crawler monitor result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "urls",
    "jobs",
    "new_sitemap_url",
    "filtered_count",
    "metadata_updates",
    "hybrid",
    "truncated"
  ],
  "properties": {
    "contract_version": {"const": "crawler.runtime/v1"},
    "urls": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}},
    "new_sitemap_url": {"type": ["string", "null"]},
    "filtered_count": {"type": "integer", "minimum": 0},
    "metadata_updates": {"type": ["object", "null"]},
    "hybrid": {"type": "boolean"},
    "truncated": {"type": "boolean"}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "sourceIdentity": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z0-9][a-z0-9._-]{0,63}:[A-Za-z0-9][A-Za-z0-9._~:/-]{0,383}$"
        }
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url", "title", "description", "locations", "employment_type",
        "job_location_type", "date_posted", "base_salary", "language",
        "localizations", "extras", "metadata"
      ],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"$ref": "#/$defs/nullableString"},
        "description": {"$ref": "#/$defs/nullableString"},
        "locations": {
          "anyOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "employment_type": {"$ref": "#/$defs/nullableString"},
        "job_location_type": {"$ref": "#/$defs/nullableString"},
        "date_posted": {"$ref": "#/$defs/nullableString"},
        "base_salary": {"type": ["object", "null"]},
        "language": {"$ref": "#/$defs/nullableString"},
        "localizations": {"type": ["object", "null"]},
        "extras": {"type": ["object", "null"]},
        "metadata": {"type": ["object", "null"]},
        "source_identity": {"$ref": "#/$defs/sourceIdentity"}
      }
    }
  }
}
