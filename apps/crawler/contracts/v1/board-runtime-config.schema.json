{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseek.dev/contracts/crawler/v1/board-runtime-config.schema.json",
  "title": "Crawler board runtime configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "board_url",
    "crawler_type",
    "check_interval_minutes",
    "scrape_interval_hours",
    "monitor_needs_browser",
    "scraper_needs_browser",
    "metadata"
  ],
  "properties": {
    "contract_version": {"const": "crawler.runtime/v1"},
    "board_url": {"type": "string", "minLength": 1, "format": "uri"},
    "crawler_type": {"type": "string", "minLength": 1},
    "company_id": {"type": "string"},
    "domain": {"type": "string"},
    "throttle_key": {"type": "string"},
    "check_interval_minutes": {"type": "integer", "minimum": 1},
    "scrape_interval_hours": {"type": "integer", "minimum": 1},
    "monitor_needs_browser": {"type": "boolean"},
    "scraper_needs_browser": {"type": "boolean"},
    "egress_host": {"type": "string"},
    "scrape_egress_host": {"type": "string"},
    "metadata": {"type": "object"}
  }
}
