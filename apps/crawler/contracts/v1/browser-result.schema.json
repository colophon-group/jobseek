{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseek.dev/contracts/crawler/v1/browser-result.schema.json",
  "title": "Candidate crawler browser execution result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "outcome", "backend", "final_url", "status", "html",
    "action_outcomes", "captures", "evaluations", "unsupported_capabilities",
    "error"
  ],
  "properties": {
    "contract_version": {"const": "crawler.runtime/v1"},
    "outcome": {"enum": ["success", "error", "unsupported"]},
    "backend": {"enum": ["chromium", "lightpanda"]},
    "final_url": {"type": ["string", "null"], "format": "uri"},
    "status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "html": {"type": ["string", "null"]},
    "action_outcomes": {"type": "array", "items": {"type": "object"}},
    "captures": {"type": "array", "items": {"type": "object"}},
    "evaluations": {"type": "object"},
    "unsupported_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["class", "message", "retryable"],
      "properties": {
        "class": {
          "enum": [
            "target_closed", "session_lost", "navigation", "timeout",
            "transport", "anti_bot", "resource_limit", "internal"
          ]
        },
        "message": {"type": "string"},
        "retryable": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "success"}}},
      "then": {
        "properties": {
          "unsupported_capabilities": {"maxItems": 0},
          "error": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "unsupported"}}},
      "then": {
        "properties": {
          "html": {"type": "null"},
          "action_outcomes": {"maxItems": 0},
          "captures": {"maxItems": 0},
          "evaluations": {"maxProperties": 0},
          "unsupported_capabilities": {"minItems": 1},
          "error": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "error"}}},
      "then": {
        "properties": {
          "html": {"type": "null"},
          "action_outcomes": {"maxItems": 0},
          "captures": {"maxItems": 0},
          "evaluations": {"maxProperties": 0},
          "unsupported_capabilities": {"maxItems": 0},
          "error": {"type": "object"}
        }
      }
    }
  ]
}
