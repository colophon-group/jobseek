{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseek.dev/contracts/crawler/v1/execution-request.schema.json",
  "title": "Candidate crawler extraction execution request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "request_id", "origin_request_id", "attempt_id",
    "kind", "deadline", "traceparent", "config_revision",
    "config_fingerprint", "board_config", "input"
  ],
  "properties": {
    "contract_version": {"const": "crawler.runtime/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "origin_request_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["monitor", "scrape"]},
    "deadline": {"type": "string", "format": "date-time"},
    "traceparent": {"type": ["string", "null"]},
    "config_revision": {"type": "string", "minLength": 1},
    "config_fingerprint": {"type": "string", "minLength": 1},
    "board_config": {"$ref": "board-runtime-config.schema.json"},
    "input": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "monitor"}}},
      "then": {"properties": {"input": {"$ref": "#/$defs/monitorInput"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "scrape"}}},
      "then": {"properties": {"input": {"$ref": "#/$defs/scrapeInput"}}}
    }
  ],
  "$defs": {
    "monitorInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monitor_type"],
      "properties": {"monitor_type": {"type": "string", "minLength": 1}}
    },
    "scrapeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "scraper_type", "scrape_step"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "scraper_type": {"type": "string", "minLength": 1},
        "scrape_step": {"type": "integer", "minimum": 0}
      }
    }
  }
}
