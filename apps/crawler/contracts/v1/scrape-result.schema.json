{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseek.dev/contracts/crawler/v1/scrape-result.schema.json",
  "title": "Crawler scrape result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "title", "description", "locations",
    "employment_type", "job_location_type", "date_posted", "base_salary",
    "language", "extras", "metadata"
  ],
  "properties": {
    "contract_version": {"const": "crawler.runtime/v1"},
    "title": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "locations": {
      "anyOf": [
        {"type": "null"},
        {"type": "array", "items": {"type": "string"}}
      ]
    },
    "employment_type": {"type": ["string", "null"]},
    "job_location_type": {"type": ["string", "null"]},
    "date_posted": {"type": ["string", "null"]},
    "base_salary": {"type": ["object", "null"]},
    "language": {"type": ["string", "null"]},
    "extras": {"type": ["object", "null"]},
    "metadata": {"type": ["object", "null"]}
  }
}
