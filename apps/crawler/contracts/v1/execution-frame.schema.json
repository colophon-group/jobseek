{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseek.dev/contracts/crawler/v1/execution-frame.schema.json",
  "title": "Crawler extraction execution frame v1",
  "oneOf": [
    {"$ref": "#/$defs/monitorBatch"},
    {"$ref": "#/$defs/scrapeResult"},
    {"$ref": "#/$defs/error"},
    {"$ref": "#/$defs/terminal"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["contract_version", "request_id", "frame_type"],
      "properties": {
        "contract_version": {"const": "crawler.runtime/v1"},
        "request_id": {"type": "string", "minLength": 1},
        "frame_type": {"type": "string"}
      }
    },
    "monitorBatch": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_version", "request_id", "frame_type", "sequence", "result"],
          "properties": {
            "contract_version": {"const": "crawler.runtime/v1"},
            "request_id": {"type": "string"},
            "frame_type": {"const": "monitor_batch"},
            "sequence": {"type": "integer", "minimum": 0},
            "result": {"$ref": "monitor-result.schema.json"}
          }
        }
      ]
    },
    "scrapeResult": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_version", "request_id", "frame_type", "result"],
          "properties": {
            "contract_version": {"const": "crawler.runtime/v1"},
            "request_id": {"type": "string"},
            "frame_type": {"const": "scrape_result"},
            "result": {"$ref": "scrape-result.schema.json"}
          }
        }
      ]
    },
    "error": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version", "request_id", "frame_type", "class",
            "retryable", "message", "details"
          ],
          "properties": {
            "contract_version": {"const": "crawler.runtime/v1"},
            "request_id": {"type": "string"},
            "frame_type": {"const": "error"},
            "class": {
              "enum": [
                "unsupported_capability", "tdm_reserved", "provider_gone",
                "permanent_gone", "http_status", "timeout", "transport",
                "anti_bot", "invalid_config", "empty_result", "internal"
              ]
            },
            "retryable": {"type": "boolean"},
            "message": {"type": "string"},
            "details": {"type": "object"}
          }
        }
      ]
    },
    "terminal": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version", "request_id", "frame_type", "status",
            "frames", "output_items", "active_duration_ms"
          ],
          "properties": {
            "contract_version": {"const": "crawler.runtime/v1"},
            "request_id": {"type": "string"},
            "frame_type": {"const": "terminal"},
            "status": {"enum": ["success", "error", "cancelled"]},
            "frames": {"type": "integer", "minimum": 0},
            "output_items": {"type": "integer", "minimum": 0},
            "active_duration_ms": {"type": "number", "minimum": 0}
          }
        }
      ]
    }
  }
}
