{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseek.ch/schemas/crawler-migration-promotion-policy-v1.json",
  "additionalProperties": false,
  "properties": {
    "browser_operation_mode": {"const": "capability-routed-dual-engine"},
    "browser_retirement_gate": {"const": "external-zero-assignment-and-removal-proof"},
    "histogram_buckets_seconds": {
      "additionalProperties": false,
      "properties": {
        "browser_operation": {"items": {"exclusiveMinimum": 0, "type": "number"}, "minItems": 2, "type": "array", "uniqueItems": true},
        "due_to_claim": {"items": {"exclusiveMinimum": 0, "type": "number"}, "minItems": 2, "type": "array", "uniqueItems": true},
        "due_to_complete": {"items": {"exclusiveMinimum": 0, "type": "number"}, "minItems": 2, "type": "array", "uniqueItems": true}
      },
      "required": ["due_to_claim", "due_to_complete", "browser_operation"],
      "type": "object"
    },
    "label_allowlists": {
      "additionalProperties": false,
      "properties": {
        "browser_backend": {"items": {"enum": ["none", "lightpanda", "chromium"]}, "minItems": 1, "type": "array", "uniqueItems": true},
        "browser_class": {"items": {"enum": ["none", "render-evaluate", "compatibility"]}, "minItems": 1, "type": "array", "uniqueItems": true},
        "cohort": {"items": {"enum": ["baseline", "candidate"]}, "minItems": 1, "type": "array", "uniqueItems": true},
        "implementation": {"items": {"enum": ["python", "go"]}, "minItems": 1, "type": "array", "uniqueItems": true},
        "provider_family": {"items": {"enum": ["direct", "static-proxy", "mixed"]}, "minItems": 1, "type": "array", "uniqueItems": true},
        "region": {"items": {"enum": ["hetzner-eu-central"]}, "minItems": 1, "type": "array", "uniqueItems": true},
        "work_class": {"items": {"enum": ["monitor", "detail"]}, "minItems": 1, "type": "array", "uniqueItems": true}
      },
      "required": ["implementation", "region", "cohort", "work_class", "browser_class", "browser_backend", "provider_family"],
      "type": "object"
    },
    "eligible_candidate_implementations": {"const": ["go"]},
    "policy_id": {"maxLength": 64, "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "type": "string"},
    "release_max_active_values": {"const": 2},
    "release_pattern": {"const": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$"},
    "required_classes": {
      "items": {"$ref": "#/$defs/requiredClass"},
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {"const": "jobseek.crawler-migration-promotion-policy/v1"},
    "scope": {"const": "crawler-runtime-only"},
    "status": {"const": "candidate"},
    "thresholds": {
      "additionalProperties": false,
      "properties": {
        "antibot_regression_ratio_max": {"minimum": 1, "type": "number"},
        "due_to_claim_p95_max_seconds": {"exclusiveMinimum": 0, "type": "number"},
        "due_to_claim_p99_max_seconds": {"exclusiveMinimum": 0, "type": "number"},
        "due_to_complete_p95_max_seconds": {"exclusiveMinimum": 0, "type": "number"},
        "due_to_complete_p99_max_seconds": {"exclusiveMinimum": 0, "type": "number"},
        "freshness_error_budget_burn_max": {"exclusiveMinimum": 0, "type": "number"},
        "max_avoidable_idle_seconds_with_eligible_backlog": {"const": 0},
        "max_backend_utilization_ratio": {"exclusiveMinimum": 0, "maximum": 1, "type": "number"},
        "min_completed_schedule_cycles": {"minimum": 1, "type": "integer"},
        "min_backend_headroom_ratio": {"maximum": 1, "minimum": 0, "type": "number"},
        "min_observation_seconds": {"minimum": 300, "type": "integer"},
        "min_rare_class_samples": {"minimum": 1, "type": "integer"},
        "min_standard_class_samples": {"minimum": 1, "type": "integer"},
        "request_amplification_ratio_max": {"minimum": 1, "type": "number"},
        "schedule_compliance_ratio_min": {"maximum": 1, "minimum": 0, "type": "number"}
      },
      "required": ["min_observation_seconds", "min_completed_schedule_cycles", "min_standard_class_samples", "min_rare_class_samples", "schedule_compliance_ratio_min", "freshness_error_budget_burn_max", "due_to_claim_p95_max_seconds", "due_to_claim_p99_max_seconds", "due_to_complete_p95_max_seconds", "due_to_complete_p99_max_seconds", "request_amplification_ratio_max", "antibot_regression_ratio_max", "max_avoidable_idle_seconds_with_eligible_backlog", "max_backend_utilization_ratio", "min_backend_headroom_ratio"],
      "type": "object"
    },
    "zero_tolerance_signals": {
      "const": ["bulk_gone_or_delist_events", "cross_backend_runtime_fallbacks", "origin_policy_violations", "queue_loss_or_duplication_events", "stale_authoritative_writes", "tdm_violations"]
    }
  },
  "required": ["schema_version", "policy_id", "status", "scope", "browser_operation_mode", "browser_retirement_gate", "eligible_candidate_implementations", "release_pattern", "release_max_active_values", "label_allowlists", "required_classes", "thresholds", "histogram_buckets_seconds", "zero_tolerance_signals"],
  "type": "object",
  "$defs": {
    "requiredClass": {
      "additionalProperties": false,
      "properties": {
        "capability_class": {"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$", "type": "string"},
        "browser_backend": {"enum": ["none", "lightpanda", "chromium"]},
        "browser_class": {"enum": ["none", "render-evaluate", "compatibility"]},
        "class_id": {"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$", "type": "string"},
        "sample_policy": {"enum": ["standard", "rare"]},
        "work_class": {"enum": ["monitor", "detail"]}
      },
      "required": ["class_id", "work_class", "capability_class", "browser_class", "browser_backend", "sample_policy"],
      "type": "object"
    }
  }
}
