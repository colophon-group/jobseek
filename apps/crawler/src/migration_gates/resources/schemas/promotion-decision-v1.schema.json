{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseek.ch/schemas/crawler-migration-promotion-decision-v1.json",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "cohort": {"const": "candidate"},
        "implementation": {"enum": ["python", "go"]},
        "region": {"enum": ["hetzner-eu-central"]},
        "release": {"pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$", "type": "string"}
      },
      "required": ["implementation", "release", "region", "cohort"],
      "type": "object"
    },
    "decision": {"enum": ["promote", "hold", "freeze"]},
    "evidence_id": {"maxLength": 64, "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "type": "string"},
    "policy_id": {"maxLength": 64, "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "type": "string"},
    "policy_status": {"const": "candidate"},
    "reasons": {
      "items": {"$ref": "#/$defs/reason"},
      "type": "array"
    },
    "routing_revision": {"pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$", "type": "string"},
    "schema_version": {"const": "jobseek.crawler-migration-promotion-decision/v1"}
  },
  "required": ["schema_version", "policy_id", "policy_status", "evidence_id", "routing_revision", "candidate", "decision", "reasons"],
  "type": "object",
  "$defs": {
    "reason": {
      "additionalProperties": false,
      "properties": {
        "affected_classes": {
          "items": {"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$", "type": "string"},
          "type": "array",
          "uniqueItems": true
        },
        "code": {
          "enum": [
            "freeze:antibot-regression",
            "freeze:backend-resource-saturation",
            "freeze:bulk-gone-or-delist",
            "freeze:cross-backend-runtime-fallback",
            "freeze:freshness-error-budget",
            "freeze:origin-policy-violation",
            "freeze:queue-loss-or-duplication",
            "freeze:request-amplification",
            "freeze:stale-authoritative-write",
            "freeze:tdm-violation",
            "hold:class-cycle-coverage",
            "hold:class-sample-coverage",
            "hold:correctness-mismatch",
            "hold:avoidable-idle-with-eligible-backlog",
            "hold:backend-capacity-headroom",
            "hold:freshness-latency",
            "hold:freshness-schedule-compliance",
            "hold:rare-population-coverage",
            "hold:replay-incomplete",
            "hold:window-duration",
            "hold:zero-assignment-unproven",
            "hold:zero-demand-unproven"
          ]
        }
      },
      "required": ["code", "affected_classes"],
      "type": "object"
    }
  }
}
