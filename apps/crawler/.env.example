# Required local crawler database
LOCAL_DATABASE_URL=postgresql://crawler:password@localhost:5432/crawler

# Optional legacy crawler mirror. Leave empty for Typesense-only export and
# reconciliation once crawler-mirror retirement is complete.
DATABASE_URL=

# Provider-neutral web-owned database boundary used by refresh-typesense for
# watchlists. This may point at Supabase Free independently of DATABASE_URL.
WEB_DATABASE_URL=postgresql://web_reader:password@localhost:5432/web

# Optional
LOG_LEVEL=INFO
CRAWLER_CONCURRENCY=10
CRAWLER_POLL_INTERVAL=15
