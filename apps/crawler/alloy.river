// alloy.river — Grafana Alloy config for crawler observability
// Static scrape targets (containers use network_mode: host)

// ── Application metrics (static targets per container) ────
prometheus.scrape "crawler" {
  targets = [
    {"__address__" = "localhost:9095", "instance" = "worker-1", "job" = "crawler"},
    {"__address__" = "localhost:9096", "instance" = "worker-2", "job" = "crawler"},
    {"__address__" = "localhost:9097", "instance" = "worker-3", "job" = "crawler"},
    {"__address__" = "localhost:9098", "instance" = "browser-1", "job" = "crawler"},
    {"__address__" = "localhost:9093", "instance" = "exporter", "job" = "crawler"},
    {"__address__" = "localhost:9094", "instance" = "drain", "job" = "crawler"},
  ]
  forward_to     = [prometheus.relabel.crawler.receiver]
  scrape_interval = "15s"
}

// The circuit breaker retains one labelled gauge/counter set per real
// upstream origin for the lifetime of every worker. With thousands of career
// sites this eventually exceeds the Grafana tenant's active-series budget.
// Keep the bounded fleet-level task outcomes for alerting; the structured
// Docker logs retain per-origin attribution for incident diagnosis.
prometheus.relabel "crawler" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "crawler_host_circuit_.*"
    action        = "drop"
  }
}

// ── Redis metrics ─────────────────────────────────────────
// Needed for the RedisMemoryPressure alert: Redis runs with
// ``--maxmemory 1gb --maxmemory-policy noeviction`` (see docker-compose.yml),
// which means writes stall when memory fills. The redis_exporter
// surfaces ``redis_memory_used_bytes`` and ``redis_memory_max_bytes``
// so that pressure is visible before a stall, instead of after.
prometheus.exporter.redis "redis_local" {
  redis_addr = "localhost:6379"
}

prometheus.scrape "redis" {
  targets        = prometheus.exporter.redis.redis_local.targets
  forward_to     = [prometheus.relabel.redis.receiver]
  scrape_interval = "15s"
}

// Command-level latency histograms multiply every Redis command into many
// bucket series. The allowlist retains the capacity, persistence, connection,
// error, traffic, CPU, and keyspace signals used to operate this single Redis
// instance without spending hundreds of series on command attribution.
prometheus.relabel "redis" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "(up|scrape_(duration_seconds|samples_scraped|samples_post_metric_relabeling|series_added)|redis_(up|memory_.*|connected_clients|blocked_clients|rejected_connections_total|evicted_keys_total|expired_keys_total|keyspace_(hits|misses)_total|commands_processed_total|net_(input|output)_bytes_total|db_keys(_expiring)?|rdb_.*|aof_.*|loading|latest_fork_seconds|cpu_.*|uptime_in_seconds))"
    action        = "keep"
  }
}

// ── Remote write ──────────────────────────────────────────
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("PROM_URL")
    basic_auth {
      username = sys.env("PROM_USERNAME")
      password = sys.env("PROM_PASSWORD")
    }
    queue_config {
      capacity             = 4000
      min_shards           = 1
      max_shards           = 1
      max_samples_per_send = 500
      batch_send_deadline  = "5s"
      min_backoff          = "1s"
      max_backoff          = "30s"
      retry_on_http_429    = true
    }
  }
}

// ── Logs (Docker stdout → Loki) ───────────────────────────
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  // Keep target removal aligned with the Docker log tailer's five-second
  // retry loop. The one-minute discovery default left deleted --rm
  // containers in the target set long enough to emit the same "No such
  // container" error twelve times after each deploy (#5106).
  refresh_interval = "5s"
}

// Promote the docker container name into a Loki label so log queries
// can attribute errors to a specific container (worker-1 vs browser-1
// vs exporter vs drain etc). Without this, every line ships with only
// `job=crawler` and a Chromium-missing burst can't be tied to the
// container that produced it. Docker exposes the name as
// `__meta_docker_container_name` with a leading `/`, e.g. `/deploy-browser-1-1`.
// We strip the `/deploy-` prefix and the trailing `-1` instance suffix so
// the label reads as the docker-compose service name (browser-1, worker-2, …).
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(?:deploy-)?(.+?)(?:-\\d+)?"
    target_label  = "container"
    replacement   = "$1"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.containers.output
  labels           = { job = "crawler" }
  refresh_interval = "5s"
  forward_to       = [loki.process.parse.receiver]
}

loki.process "parse" {
  stage.json {
    expressions = {
      level = "level",
      event = "event",
    }
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("LOKI_URL")
    basic_auth {
      username = sys.env("LOKI_USERNAME")
      password = sys.env("LOKI_PASSWORD")
    }
  }
}
