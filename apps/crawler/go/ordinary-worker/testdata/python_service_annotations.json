  {
    "name": "cyberbit-rangeforce-bamboohr",
    "board": {
      "provider": "api_sniffer",
      "board_url": "https://rangeforce.bamboohr.com/careers/",
      "metadata": {
        "api_url": "https://rangeforce.bamboohr.com/careers/list",
        "method": "GET",
        "json_path": "result",
        "url_template": "https://rangeforce.bamboohr.com/careers/{id}",
        "fields": {
          "title": "jobOpeningName",
          "employment_type": {
            "path": "employmentStatusLabel",
            "map": {
              "Contractor": "contract",
              "Full-Time": "full_time"
            }
          },
          "metadata.department": "departmentLabel"
        },
        "defaults": {
          "job_location_type": "remote"
        },
        "wait": "domcontentloaded",
        "settle": 2,
        "scraper_type": "api_sniffer",
        "scraper_config": {
          "api_url": "https://rangeforce.bamboohr.com/careers/{id}/detail",
          "method": "GET",
          "json_path": "result",
          "enrich": [
            "description",
            "job_location_type"
          ],
          "fields": {
            "description": "jobOpening.description",
            "job_location_type": "=remote"
          }
        }
      }
    },
    "response": "{\"result\": [{\"id\": 123, \"jobOpeningName\": \"Engineer\", \"employmentStatusLabel\": \"Full-Time\", \"departmentLabel\": \"Security\"}]}",
    "expected": [
      {
        "url": "https://rangeforce.bamboohr.com/careers/123",
        "title": "Engineer",
        "description": null,
        "locations": null,
        "employment_type": "full_time",
        "job_location_type": null,
        "date_posted": null,
        "base_salary": null,
        "language": null,
        "localizations": null,
        "extras": null,
        "metadata": {
          "department": "Security"
        },
        "source_identity": null
      }
    ],
    "browser": false,
    "exchanges": [
      {
        "method": "GET",
        "url": "https://rangeforce.bamboohr.com/careers/list",
        "body": ""
      }
    ]
  },
  {
