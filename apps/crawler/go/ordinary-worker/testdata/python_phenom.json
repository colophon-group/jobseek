    {
      "name": "trailing-xml-comment",
      "resources": {
        "/sitemap.xml": {
          "body": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://example.com/job/one?utm_source=test&amp;x=1</loc></url><url><loc>https://example.com/Job?job_id=two</loc></url><url><loc>https://example.com/home</loc></url><url><loc>https://example.com/job/one?x=1</loc></url></urlset><!-- carrier -->",
          "status": 200,
          "headers": {
            "Content-Type": "text/xml"
          }
        }
      },
      "metadata": {
        "sitemap_url": "https://example.com/sitemap.xml"
      },
      "requests": [
        {
          "method": "GET",
          "url": "https://example.com/sitemap.xml"
        }
      ],
      "expected": {
        "error": false,
        "urls": [
          "https://example.com/Job?job_id=two",
          "https://example.com/job/one?x=1"
        ],
        "new_sitemap_url": null
      }
    },
