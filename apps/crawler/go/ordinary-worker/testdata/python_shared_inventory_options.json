    "board": {
      "provider": "dom",
      "board_url": "https://racks.vertiv.com/current-job-openings/",
      "metadata": {
        "fetch_url_transform": {
          "find": "^https://racks\\.vertiv\\.com(/[^?]*)$",
          "replace": "https://racks-vertiv-com.translate.goog\\1?_x_tr_sl=auto&_x_tr_tl=en&_x_tr_hl=en"
        },
        "url_filter": "^https://racks-vertiv-com\\.translate\\.goog/(?:welder|press-brake-operator|assembly|powder-coater)/",
        "url_transform": {
          "find": "^https://racks-vertiv-com\\.translate\\.goog(/[^?]+).*$",
          "replace": "https://racks.vertiv.com\\1"
        },
        "scraper_type": "dom",
        "scraper_config": {
          "fetch_url_transform": {
            "find": "^https://racks\\.vertiv\\.com(/[^?]*)$",
            "replace": "https://racks-vertiv-com.translate.goog\\1?_x_tr_sl=auto&_x_tr_tl=en&_x_tr_hl=en"
          },
          "scope": ".section__inner.richtext-entry",
          "include_document_title": true,
          "steps": [
            {
              "tag": "title",
              "field": "title",
              "regex": "^(.*?) - Vertiv"
            },
            {
              "tag": "p",
              "field": "description",
              "html": true,
              "to_end": true
            }
          ],
          "defaults": {
            "locations": [
              "Corry, PA, United States"
            ],
