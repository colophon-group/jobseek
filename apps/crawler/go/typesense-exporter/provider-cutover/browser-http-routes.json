cation = {'@type':'Place',name:location,address:{'@type':'PostalAddress',addressLocality:location}}; if (employmentType) posting.employmentType = employmentType; const script = document.createElement('script'); script.type = 'application/ld+json'; script.dataset.jobseekExpr3ss = 'true'; script.textContent = JSON.stringify(posting); document.head.appendChild(script); return true; }"
        }
