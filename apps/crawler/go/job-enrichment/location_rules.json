  "patterns": {
    "_TYPE_HINT_RE": {
      "pattern": "\\b(?:remote|fully\\s+remote|100%\\s+remote|telecommute|work\\s+from\\s+home|wfh|hybrid|partially\\s+remote|flexible|on[\\s-]?site|in[\\s-]?office|in[\\s-]?person)\\b",
      "ignore_case": true
    },
    "_PAREN_HINT_RE": {
      "pattern": "\\(([^)]+)\\)",
      "ignore_case": false
    },
    "_PURE_REMOTE_RE": {
      "pattern": "^(?:fully\\s+)?remote$|^100%\\s+remote$|^telecommute$|^work\\s+from\\s+home$|^wfh$",
      "ignore_case": true
    },
    "_SKIP_RE": {
      "pattern": "^(?:multiple\\s+locations?|various\\s+locations?|global|tbd|n/a|see\\s+description|distributed)$",
      "ignore_case": true
    },
    "_COUNTRY_LOCATIONS_RE": {
      "pattern": "^(.+?)\\s+locations?$",
      "ignore_case": true
    },
    "_OTHER_LOCATIONS_RE": {
      "pattern": "\\s*[&+]\\s*(?:other\\s+locations?|more|others?).*$",
      "ignore_case": true
    },
    "_STANDALONE_TYPE_RE": {
      "pattern": "^(?:hybrid|on[\\s-]?site|in[\\s-]?office|in[\\s-]?person)$",
      "ignore_case": true
    },
    "_STATE_PREFIX_RE": {
      "pattern": "^([A-Z]{2})-(.+)$",
      "ignore_case": false
    },
    "_COUNTRY_SUFFIX_RE": {
      "pattern": "^(.+?)-([A-Z]{2,3})$",
      "ignore_case": false
    },
    "_SPLIT_RE": {
      "pattern": "[,/|;]\\s*|\\s+-\\s+|\\s+–\\s+|\\s*[•·]\\s*|\\s+&\\s+",
      "ignore_case": false
    },
    "_POSTAL_CODE_RE": {
      "pattern": ",\\s*\\d{4,5}\\s*$",
      "ignore_case": false
    },
    "_THE_PREFIX_RE": {
      "pattern": "^the\\s+",
      "ignore_case": true
    },
    "_CITY_SUFFIX_RE": {
      "pattern": "\\s+city$",
      "ignore_case": true
    },
    "_COMBINING_RE": {
      "pattern": "[\\u0300-\\u036f]+",
      "ignore_case": false
    },
    "_OFFICE_SUFFIX_RE": {
      "pattern": "\\s+(?:HQ|Office|Campus|Branch|Headquarters)\\s*$",
      "ignore_case": true
    }
  },
