{
  "wait": "networkidle",
  "proxy": true,
  "render": true,
  "actions": [
    {
      "max": 50,
      "action": "repeat",
      "wait_ms": 1500,
      "selector": ".load_more_jobs"
    }
  ],
  "stealth": true,
  "timeout": 30000,
  "url_filter": "^https?://(?:www\\.)?alten\\.fi/(?:en/)?jobs/[0-9]+-[^/?#]+/?$",
  "scraper_type": "dom",
  "scraper_config": {
    "wait": "domcontentloaded",
    "proxy": true,
    "steps": [
      {
        "tag": "h1",
        "field": "title"
      },
      {
        "html": true,
        "stop": "Apply",
        "field": "description",
        "optional": true
      },
      {
        "from": 0,
        "text": "Job info",
        "field": "date_posted",
        "offset": 1,
        "optional": true,
        "date_input_format": "%d/%m/%Y"
      },
      {
        "from": 0,
        "text": "Job info",
        "field": "locations",
        "offset": 2
      }
    ],
    "render": true,
    "stealth": true,
    "timeout": 30000,
    "resource_policy": "none",
    "transport_attempts": 3
  },
  "resource_policy": "none",
  "transport_attempts": 3
}
