{
  "metadata": {
    "source": "browser",
    "browser_expression": "({jobs: jobList})",
    "path": "jobs",
    "url_template": "{link}",
    "fields": {
      "title": "title",
      "description": "desc",
      "locations": "=Shanghai, China",
      "employment_type": "=full_time",
      "job_location_type": "=onsite"
