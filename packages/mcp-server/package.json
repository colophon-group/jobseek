{
  "name": "@jseek/mcp-server",
  "version": "0.2.0",
  "mcpName": "io.github.colophon-group/jobseek",
  "description": "MCP server for Job Seek — search jobs and companies on jseek.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colophon-group/jobseek.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "bin": {
    "jobseek-mcp": "src/bin/jobseek-mcp.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./handler": "./dist/handler.js",
    "./public-api-contract": "./dist/public-api-contract.js"
  },
  "files": [
    "dist",
    "src/bin/jobseek-mcp.js"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
