{
  "name": "@jseek/mcp-server",
  "version": "0.4.0",
  "mcpName": "io.github.colophon-group/jobseek",
  "description": "Job Seek MCP: search jobs, salaries and companies, prepare career watchlist links, and submit feedback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colophon-group/jobseek.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "bin": {
    "jobseek-mcp": "src/bin/jobseek-mcp.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./handler": "./dist/handler.js",
    "./public-api-contract": "./dist/public-api-contract.js",
    "./metadata": "./dist/metadata.js",
    "./feedback-contract": "./dist/feedback-contract.js"
  },
  "files": [
    "dist",
    "src/bin/jobseek-mcp.js"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://jseek.co",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "job-search",
    "jobs",
    "careers",
    "salary",
    "remote-jobs",
    "watchlists",
    "jobseek"
  ]
}
