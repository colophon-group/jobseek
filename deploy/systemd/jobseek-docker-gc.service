[Unit]
Description=Bound Jobseek Docker storage
Documentation=https://github.com/colophon-group/jobseek/blob/main/docs/16-hetzner-maintenance.md#docker-gc-timer
After=docker.service
Wants=docker.service
ConditionPathExists=/usr/local/sbin/jobseek-docker-gc
ConditionPathExists=/etc/jobseek-observability/host.env

[Service]
Type=oneshot
EnvironmentFile=/etc/jobseek-observability/host.env
ExecStart=/usr/local/sbin/jobseek-docker-gc
TimeoutStartSec=10m
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryMax=256M
Nice=10

ReadWritePaths=/run
