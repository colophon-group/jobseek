# Renderer deploys may only attest the root-owned policy immediately around start.
deploy ALL=(root) NOPASSWD: /usr/local/libexec/jobseek-lightpanda-network-policy verify-ready [0-9a-f]* [0-9a-f]*
deploy ALL=(root) NOPASSWD: /usr/local/libexec/jobseek-lightpanda-network-policy verify-running-ready [0-9a-f]* [0-9a-f]*
deploy ALL=(root) NOPASSWD: /usr/local/libexec/jobseek-lightpanda-network-policy quarantine
